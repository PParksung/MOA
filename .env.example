# ============================================================
# MOA 환경변수 템플릿
#   cp .env.example .env  후 값 채우기. .env 는 git 에 올리지 않는다.
#   docker compose 와 각 서버(bootRun)가 같은 .env 를 읽는다.
# ============================================================

# --- MySQL (docker-compose.yml) ---
DB_ROOT_PASSWORD=change-me-root
DB_USERNAME=moa
DB_PASSWORD=change-me

# --- security-server ---
# JWT HS256 서명키. 256bit 이상 필요 → 32바이트 이상 랜덤값을 Base64로
#   생성: openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM 키. 정확히 32바이트를 Base64로 (IV는 암호화마다 랜덤 생성하므로 설정 없음)
#   생성: openssl rand -base64 32
AES_KEY=

# --- market-server (한국투자증권 Open API) ---
KIS_APP_KEY=
KIS_APP_SECRET=

# --- ai-server ---
LLM_API_KEY=
LLM_API_URL=

# --- 선택: 다른 호스트/포트를 쓸 때만 ---
# REDIS_HOST=localhost
# EXCHANGE_SERVER_URL=http://localhost:8081
